<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/th_bg</item>
        <item name="android:colorPrimary">@color/th_accent</item>
        <item name="android:colorAccent">@color/th_accent</item>
        <item name="android:statusBarColor">@color/th_bg</item>
        <item name="android:navigationBarColor">@color/th_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:dialogCornerRadius">20dp</item>
    </style>

    <!-- 底部面板（Sheet） -->
    <style name="SheetTheme" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:colorAccent">@color/th_accent</item>
        <item name="android:colorPrimary">@color/th_accent</item>
    </style>
</resources>
